{
    "layer": "top",
    "position": "top",
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock",
        "sway/window"
    ],
    "modules-right": [
        "pulseaudio",
        "pulseaudio/slider",
        "custom/music",
        "bluetooth",
        "network",
        "battery"
    ],
    "sway/window": {
        "max-length": 50
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5
        }
    },
    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true
    },
    "clock": {
        "interval": 1,
        "format": "{:%H %M %S | %A %d %B %Y}"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": [
            "Easy Effects Sink"
        ]
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "custom/music": {
        "exec": "/home/fut/dotfiles/waybar/.config/waybar/scripts/music.sh 2>&1",
        "interval": 2,
        "format": "{}",
        "max-length": 50,
        "escape": true,
        "tooltip": false,
        "on-click": "/home/fut/dotfiles/waybar/.config/waybar/scripts/music.sh playpause",
        // "on-click-right": "/home/fut/dotfiles/waybar/.config/waybar/scripts/music.sh open",
        "on-scroll-up": "/home/fut/dotfiles/waybar/.config/waybar/scripts/music.sh next",
        "on-scroll-down": "/home/fut/dotfiles/waybar/.config/waybar/scripts/music.sh prev"
    },
    "network": {
        "interface": "wlp1s0",
        "format": "{ifname}",
        "format-wifi": "",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "format-disconnected": "", //An empty format will hide the module.
        "tooltip-format": "{essid} ({signalStrength}%)",
        "on-click": "nm-connection-editor",
        "max-length": 50
    },
    "bluetooth": {
        // "controller": "controller1", // specify the alias of the controller if there are more than 1 on the system
        "format": "",
        "format-disabled": "", // an empty format will hide the module
        "format-connected": " {num_connections} connected",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },
    "battery": {
        "interval": 2,
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{icon} {time}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    }
}